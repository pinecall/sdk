# Your Pinecall API key
PINECALL_API_KEY=pk_...

# The knowledge base tapped from maravillacleaners.com (see ../scripts/tap.mjs).
MARAVILLA_KB_ID=6a88ce38093d0c0b471822b4

# The agent slug this process owns. `maravilla` in production, `dev-maravilla`
# on your machine — two processes on the same slug fight over it.
AGENT_SLUG=dev-maravilla

# A number from your Pinecall inventory. Optional — without it, browser only.
# PHONE=+1...

# Production. Without it React Router loads its development bundle.
NODE_ENV=production

# The port the Express server listens on.
PORT=3000

# Optional: write every wire event the SDK receives to this file (debugging).
# PINECALL_LOG=./pinecall.log
